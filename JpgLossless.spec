datas = [('web/index.html', 'web')]
hiddenimports = ['webview']
datas += collect_data_files('webview')
hiddenimports += collect_submodules('webview')


a = Analysis(
    ['jpg_lossless_web.py'],
    pathex=[],
    binaries=[('bin/ect.exe', 'bin')],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='JpgLossless',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
